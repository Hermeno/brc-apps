# Copy to .env.local and fill in. Never commit the filled copy — .gitignore
# covers it, but note that an ignore rule does not apply to a file git is
# already tracking, which is how a real one reached this repository once.

# ─── Database ─────────────────────────────────────────────────────────────────
# DIRECT_URL bypasses the connection pooler and is what Prisma migrations use.
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# ─── Auth ─────────────────────────────────────────────────────────────────────
# NEXTAUTH_SECRET signs the session cookie. Anyone holding it can mint a session
# for any account, including an admin, so it is rotated like a password, never
# shared between environments, and generated with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Gates POST /api/auth/setup-admin, which promotes an account to ADMIN. Leave it
# unset outside the initial setup — the route refuses to run without it.
ADMIN_SETUP_SECRET=

# ─── Scheduler ────────────────────────────────────────────────────────────────
# REQUIRED. GET /api/cron/waves is the only caller of advanceWaves(), which moves
# leads Wave1→Wave2→Wave3 and expires unpaid fee deadlines. The route refuses to
# run without this secret, and nothing else advances a lead — so if it is unset,
# or if no scheduler is actually calling the route, matching quietly stops.
CRON_SECRET=

# ─── Payments ─────────────────────────────────────────────────────────────────
# All three from the same Stripe account and mode (test or live).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Verliks

# ─── Uploads ──────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Public ───────────────────────────────────────────────────────────────────
# Reaches the browser. Never put a secret behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
